{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/db": ["./db/index.ts"],
      "@/db/*": ["./db/*"],
      "@/schema/*": ["./db/schema/*"]
    }
  },
  "include": ["db/**/*", "scripts/**/*", "drizzle.config.ts", "scratch-recreate-tables.ts"],
  "exclude": ["node_modules", "drizzle"]
}