{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["./lib/*"],
      "@/components/*": ["./components/*", "./components/ui/*"],
      "@/components/ui/*": ["./components/ui/*"],
      "@/hooks/*": ["./hooks/*"]
    }
  },
  "include": ["components/**/*", "lib/**/*", "hooks/**/*"],
  "exclude": ["node_modules"]
}