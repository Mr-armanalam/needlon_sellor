# # Copy to .env.local and fill in the values. Never commit .env.local.
# #
# # The admin app shares the platform's database and seller-session auth:
# # an admin is a seller row with role = 'admin' (promote one with
# # packages/db/scripts/promote-admin.ts). Sessions are the platform's
# # standard access_token / refresh_token cookies, so these values must
# # match the seller app's.

# # --- Database ---
# DATABASE_URL=

# # --- Session tokens (must match apps/seller) ---
# JWT_ACCESS_SECRET=
# <redacted>=

# # --- Redis (optional; session blocklist + login rate limiting) ---
# # When unset, the blocklist/rate-limit helpers degrade gracefully.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
