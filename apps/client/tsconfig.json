{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/db": ["../../packages/db/db/index.ts"],
      "@/db/*": ["../../packages/db/db/*", "../../packages/db/*"],
      "@/schema/*": ["../../packages/db/db/schema/*"],
      "@/components/ui/*": ["../../packages/ui/components/ui/*"],
      "@/components/*": ["./components/*", "../../packages/ui/components/*", "../../packages/ui/components/ui/*"],
      "@/modules/*": ["../../packages/client-packages/client-modules/*"],
      "@/data/*": ["../../packages/client-packages/data/*"],
      "@/features/*": ["../../packages/client-packages/features/*"],
      "@/store/*": ["../../packages/client-packages/store/*"],
      "@needlon/ui/*": ["../../packages/ui/*"],
      "@needlon/ui": ["../../packages/ui"],
      "@needlon/db/*": ["../../packages/db/*"],
      "@needlon/db": ["../../packages/db/db/index.ts"],
      "@needlon/modules/*": ["../../packages/modules/*"],
      "@needlon/modules": ["../../packages/modules/modules/index.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/client-packages/**/*.ts",
    "../../packages/client-packages/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
