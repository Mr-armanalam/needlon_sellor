# Copy to .env.local and fill in the values. Never commit .env.local.
# Values live in the Supabase dashboard / Stripe dashboard / your secret store.

# --- Auth (NextAuth v5) ---
# AUTH_SECRET is preferred; NEXTAUTH_SECRET works as a fallback (see auth.ts).
AUTH_SECRET=
# NEXTAUTH_SECRET=

# --- Database (Drizzle ORM, packages/db) ---
DATABASE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# This project's legacy name for the Supabase anon (publishable) key.
NEXT_PUBLIC_SUPABASE_API_KEY=
NEXT_PUBLIC_URL=

# --- Stripe (client checkout only) ---
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Country/State API (address forms) ---
COUNTRY_STATE_API_KEY=
COUNTRY_STATE_ENDPOINT=
