# Copy to .env.local and fill in the values. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Delivery / carrier credentials ---
# 64 hex characters (32 bytes) used to encrypt sellers' carrier API
# credentials at rest. Generate with: openssl rand -hex 32
CARRIER_CREDENTIALS_KEY=

# --- Shiprocket webhook ---
# Security token configured in the Shiprocket panel (Settings > API >
# Webhooks). Shiprocket sends it in the `x-api-key` header of every
# tracking webhook; POST /api/webhooks/shiprocket rejects requests whose
# header does not match, and returns 503 while this is unset.
SHIPROCKET_WEBHOOK_SECRET=
