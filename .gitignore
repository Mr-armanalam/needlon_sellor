# ==============================================================================
# Needlon Monorepo Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
pnpm-lock.yaml.tmp

# Next.js Build Outputs & Cache
.next/
out/
build/
dist/

# Turborepo Cache
.turbo/

# Environment Variables & Secrets (All levels: root, apps, packages)
.env
.env*
!.env.example
!.env*.example
*.env.local

# Database & Migrations
*.sqlite
*.sqlite3
*.db
# Ignore generated schema diff snapshots or local scratch runs if sensitive
scratch-recreate-tables.ts.log

# Drizzle Kit output artifacts (keep SQL migrations, ignore temporary run caches)
packages/db/drizzle/.temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# IDEs & Editor Configuration
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# TypeScript declaration cache
*.tsbuildinfo
next-env.d.ts

# Docker artifacts
.docker/
docker-compose.override.yml